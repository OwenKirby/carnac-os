diff --git a/src/dsp/pcm_store.c b/src/dsp/pcm_store.c
new file mode 100644
index 0000000..72078a7
--- /dev/null
+++ b/src/dsp/pcm_store.c
@@ -0,0 +1,98 @@
+/* PCM waves in the store flash: the image check and the wave list (pcm_store.h). */
+#include <stddef.h>
+#include "pcm_store.h"
+#include "wavetables.h"                     /* wavetable_crc32 */
+
+static const uint8_t *pcm_img[PCM_AREAS];
+static uint32_t pcm_n[PCM_AREAS];
+
+int pcm_store_check(const uint8_t *img, uint32_t size)
+{
+    const PcmHdr *h = (const PcmHdr *)(const void *)img;
+    uint32_t i, dir_end;
+    if (!img || ((uintptr_t)img & 3u) || size < PCM_HDR_SIZE)
+        return -1;
+    if (h->magic != PCM_MAGIC || h->hcrc != wavetable_crc32(0, h, PCM_HDR_SIZE - 4u))
+        return -1;
+    if (h->version != PCM_VERSION || h->count > PCM_MAX_WAVES || h->len > size ||
+        h->rsv[0] || h->rsv[1] || h->rsv[2])
+        return -2;
+    dir_end = PCM_HDR_SIZE + (uint32_t)h->count * PCM_ENTRY_SIZE;
+    if (h->len < dir_end)
+        return -2;
+    for (i = 0; i < h->count; i++) {
+        const PcmEntry *e = (const PcmEntry *)(const void *)(img + PCM_HDR_SIZE + i * PCM_ENTRY_SIZE);
+        uint32_t w = e->fmt == PCM_FMT_S16 ? 2u : 1u;
+        if (e->fmt > PCM_FMT_ULAW || (e->flags & ~(PCM_FLAG_LOOP | PCM_FLAG_CYCLE)) || e->root > 127u)
+            return -3;
+        if (e->len == 0u || e->off < dir_end || e->off > h->len || e->len > (h->len - e->off) / w ||
+            (w == 2u && (e->off & 1u)))
+            return -3;                              /* the samples inside the image, after the entries */
+        if (e->flags & PCM_FLAG_LOOP) {
+            if (e->loop_start >= e->loop_end || e->loop_end > e->len)
+                return -3;
+        } else if (e->loop_start || e->loop_end || (e->flags & PCM_FLAG_CYCLE)) {
+            return -3;
+        }
+        if ((e->flags & PCM_FLAG_CYCLE) ? (e->cycles == 0u || e->rate != 0u)
+                                        : (e->cycles != 0u || e->rate < 4000u || e->rate > 96000u))
+            return -3;
+    }
+    if (wavetable_crc32(0, img + PCM_HDR_SIZE, h->len - PCM_HDR_SIZE) != h->crc)
+        return -4;
+    return h->count;
+}
+
+int pcm_store_attach(uint32_t a, const uint8_t *img, uint32_t size)
+{
+    int n;
+    if (a >= PCM_AREAS)
+        return -1;
+    pcm_store_detach(a);
+    n = pcm_store_check(img, size);
+    if (n > 0) {
+        pcm_img[a] = img;
+        pcm_n[a] = (uint32_t)n;
+    }
+    return n;
+}
+
+void pcm_store_detach(uint32_t a)
+{
+    if (a < PCM_AREAS) {
+        pcm_n[a] = 0;
+        pcm_img[a] = NULL;
+    }
+}
+
+uint32_t pcm_area_count(uint32_t a) { return a < PCM_AREAS ? pcm_n[a] : 0u; }
+
+uint32_t pcm_area_used(uint32_t a)
+{
+    return a < PCM_AREAS && pcm_img[a] ? ((const PcmHdr *)(const void *)pcm_img[a])->len : 0u;
+}
+
+uint32_t pcm_wave_count(void)
+{
+    uint32_t a, n = 0;
+    for (a = 0; a < PCM_AREAS; a++)
+        n += pcm_n[a];
+    return n;
+}
+
+const PcmEntry *pcm_wave(uint32_t i, const uint8_t **data)
+{
+    uint32_t a;
+    for (a = 0; a < PCM_AREAS; a++) {
+        if (i < pcm_n[a]) {
+            const PcmEntry *e = (const PcmEntry *)(const void *)(pcm_img[a] + PCM_HDR_SIZE + i * PCM_ENTRY_SIZE);
+            if (data)
+                *data = pcm_img[a] + e->off;
+            return e;
+        }
+        i -= pcm_n[a];
+    }
+    if (data)
+        *data = NULL;
+    return NULL;
+}
diff --git a/src/dsp/pcm_store.h b/src/dsp/pcm_store.h
new file mode 100644
index 0000000..9d9ca04
--- /dev/null
+++ b/src/dsp/pcm_store.h
@@ -0,0 +1,66 @@
+/* PCM waves in the store flash (2026-10-21): uploaded over USB-MIDI into flash the firmware leaves free, read in place.
+ *
+ * The app slot is nearly full (wavetables + attacks), so PCM-style waves (single cycles, or looped samples) live in the
+ * FM1's data area instead, in "areas" the preset store does not use (src/hardware/pcm_store_fm1.c lists them). Each area
+ * holds one image of its own, so uploading one never touches another:
+ *
+ *   +0      PcmHdr      32 B, written last: an upload cut off leaves the area empty, never half a wave
+ *   +32     PcmEntry    x count, 36 B each
+ *   +off    the samples each entry names (int16 little-endian, 2-byte aligned; or 8-bit mu-law)
+ *
+ * The header's CRC-32 covers everything after it, up to len. pcm_store_check range-checks every entry before an area is
+ * attached, so a consumer can trust off / len / loop points without checking them again.
+ * Samples: PCM_FMT_S16 Q15; PCM_FMT_ULAW the attacks' 8-bit mu-law (mu 255, int8 -127..127, attack_mulaw decodes it).
+ * Pitch: a PCM_FLAG_CYCLE wave holds `cycles` whole cycles between its loop points (rate is not used: it plays at
+ * any pitch by stepping through the loop); other waves play at `rate` Hz with `root` as their MIDI note.
+ * The tool: src/hardware/pcm_store_upload.py (build an image from WAVs, upload, info). Nothing plays the waves yet. */
+#ifndef PCM_STORE_H
+#define PCM_STORE_H
+#include <stdint.h>
+
+#define PCM_MAGIC 0x57505243u               /* "CRPW" */
+#define PCM_VERSION 1u
+#define PCM_AREAS 2u
+#define PCM_NAME_LEN 12u                    /* NUL-padded; a full 12 has no NUL */
+#define PCM_MAX_WAVES 64u                   /* in one area */
+#define PCM_HDR_SIZE 32u
+#define PCM_ENTRY_SIZE 36u
+
+enum { PCM_FMT_S16 = 0, PCM_FMT_ULAW = 1 };
+#define PCM_FLAG_LOOP 1u                    /* loop_start..loop_end repeats; without it the wave plays once */
+#define PCM_FLAG_CYCLE 2u                   /* the loop is `cycles` whole cycles (needs LOOP) */
+
+typedef struct {
+    uint32_t magic;                         /* PCM_MAGIC */
+    uint16_t version, count;                /* PCM_VERSION; the entries */
+    uint32_t len;                           /* the whole image, header included */
+    uint32_t crc;                           /* CRC-32 of bytes 32..len */
+    uint32_t rsv[3];                        /* 0 */
+    uint32_t hcrc;                          /* CRC-32 of the 28 bytes before it */
+} PcmHdr;
+
+typedef struct {
+    char name[PCM_NAME_LEN];
+    uint8_t fmt, flags, root, cycles;       /* PCM_FMT_*; PCM_FLAG_*; MIDI note at rate; cycles in the loop (CYCLE) */
+    uint32_t rate;                          /* Hz (4000..96000), 0 for a CYCLE wave */
+    uint32_t off;                           /* first sample, from the image start */
+    uint32_t len;                           /* samples */
+    uint32_t loop_start, loop_end;          /* samples, loop_start < loop_end <= len (LOOP); else 0, 0 */
+} PcmEntry;
+
+_Static_assert(sizeof(PcmHdr) == PCM_HDR_SIZE && sizeof(PcmEntry) == PCM_ENTRY_SIZE, "the stored layout");
+
+/* the image at img, in an area of size bytes: its wave count (0..PCM_MAX_WAVES), or < 0: -1 no image (erased or
+ * other data), -2 header, -3 entry, -4 data CRC */
+int pcm_store_check(const uint8_t *img, uint32_t size);
+/* check the image and, if it holds, use its waves for area a; else the area is empty. Returns as pcm_store_check. */
+int pcm_store_attach(uint32_t a, const uint8_t *img, uint32_t size);
+void pcm_store_detach(uint32_t a);          /* before the area is erased or written */
+uint32_t pcm_area_count(uint32_t a);        /* the waves area a holds now */
+uint32_t pcm_area_used(uint32_t a);         /* its image's bytes (0: empty) */
+/* the waves in order: area 0's, then area 1's */
+uint32_t pcm_wave_count(void);
+/* wave i's entry, and its first sample in *data (both in flash); NULL when there is no wave i */
+const PcmEntry *pcm_wave(uint32_t i, const uint8_t **data);
+
+#endif
diff --git a/src/hardware/pcm_store_fm1.c b/src/hardware/pcm_store_fm1.c
new file mode 100644
index 0000000..d94346f
--- /dev/null
+++ b/src/hardware/pcm_store_fm1.c
@@ -0,0 +1,205 @@
+/* PCM waves in the store flash on the FM1 (2026-10-21, src/dsp/pcm_store.h): a unity-build fragment, like
+ * preset_store_fm1.c. synth_main_fm1.c includes it after the preset store and the editor helpers (ed_b, ed_str);
+ * X0X's storage.c gives st_erase / st_prog; syn_lock / syn_unlock and flash_ok are the glue's.
+ *
+ * The areas: flash in X0X's data area (0x97000..0xDFFFF, writable, read as plaintext through XIP) that nothing of
+ * Carnac's uses:
+ *   0  0x97000..0x9FFFF  36 KiB  X0X's sound / pattern / song objects (Carnac never reads them; a unit that ran X0X
+ *                                has its old objects there, which read as no image)
+ *   1  0xCE000..0xDBFFF  56 KiB  the preset store's tail: its chunks 23 and 24 (free since 2026-10-17, PS_NCHUNK 23
+ *                                now) and the 40 KiB after them, up to X0X's panel calibration (OBJ_PANEL, 0xDC000)
+ * Left alone: OBJ_PANEL 0xDC000 (the panel calibration), 0xDE000 (X0X's motion object: free, 8 KiB, kept spare),
+ * 0xE0000.. (the update loader's staging) and the preset store's free chunks 1 and 14..16 (its room to grow).
+ *
+ * The editor's commands (SysEx F0 7D 46 4C cmd args F7, as the old wavetable upload; src/hardware/pcm_store_upload.py):
+ *   100 PCM_BEGIN [area]                 the area is detached and its first sector erased: it reads empty from now on
+ *                                        -> area, rc
+ *   101 PCM_WRITE [off x3, data packed]  image bytes from offset 32, in order; each sector is erased as the writes
+ *                                        reach it -> off x3, rc
+ *   102 PCM_END   [header packed]        the 32-byte header, programmed last; the image is checked (pcm_store_check)
+ *                                        and attached, or its magic is zeroed (the area reads empty) -> rc, waves
+ *   103 PCM_INFO  [area, first]          -> areas, area, waves, size KiB x2, used bytes x3, then up to 16 names
+ *                                        from wave `first` of the area
+ * rc: 0 ok, 1 arguments, 2 flash, 3 order (no BEGIN, or not the next offset), 4 too big for the area, 5 refused on
+ * the check (the reply then carries pcm_store_check's reason + 8 as the wave count).
+ * The erases stop the audio for tens of ms each (st_erase silences it first): an upload is a studio job. */
+#include "pcm_store.h"
+
+#ifndef PCM_XIP
+#define PCM_XIP(off) ((const uint8_t *)FM1_XIP(off))
+#endif
+#define PCM_SECTOR 4096u
+enum { ED_PCM_BEGIN = 100, ED_PCM_WRITE, ED_PCM_END, ED_PCM_INFO };
+static const struct { uint32_t base, size; } PCM_AREA[PCM_AREAS] = {
+    {0x97000u, 0x9000u},
+    {0xCE000u, 0xE000u},
+};
+#ifdef PS_NCHUNK                                    /* (the firmware: the preset store comes first; not in the host test) */
+PS_STATIC_ASSERT(0x97000u + 0x9000u <= PS_BASE, "area 0 ends below the preset store");
+PS_STATIC_ASSERT(PS_BASE + PS_NCHUNK * 2u * PS_SECTOR <= 0xCE000u, "area 1 starts after the preset store's chunks");
+#endif
+_Static_assert(0xCE000u + 0xE000u <= 0xDC000u, "area 1 ends below X0X's panel calibration (OBJ_PANEL)");
+
+static struct {
+    uint8_t on, area;                               /* an upload since PCM_BEGIN, into area */
+    uint32_t next;                                  /* the offset the next PCM_WRITE must start at */
+    uint32_t erased;                                /* the area's bytes erased so far (whole sectors) */
+} pcm_up;
+static uint8_t pcm_buf[256] __attribute__((aligned(4)));   /* a write's bytes, in RAM for the flash driver */
+
+static void pcm_boot(void)                          /* after ps_load: attach whatever the areas hold */
+{
+    uint32_t a;
+    for (a = 0; a < PCM_AREAS; a++)
+        if (flash_ok)
+            pcm_store_attach(a, PCM_XIP(PCM_AREA[a].base), PCM_AREA[a].size);
+}
+
+/* 7-bit packed bytes (groups of up to 7, each after their top bits) -> out; their count, or -1 when over max */
+static int pcm_unpack7(const uint8_t *a, uint32_t na, uint8_t *out, uint32_t max)
+{
+    uint32_t n = 0, i, j;
+    for (i = 0; i < na; i += 8u) {
+        uint32_t top = a[i], k = na - i - 1u > 7u ? 7u : na - i - 1u;
+        for (j = 0; j < k; j++) {
+            if (n >= max)
+                return -1;
+            out[n++] = (uint8_t)(a[i + 1u + j] | (((top >> j) & 1u) << 7));
+        }
+    }
+    return (int)n;
+}
+
+static uint32_t pcm_u21(const uint8_t *a) { return (uint32_t)a[0] | (uint32_t)a[1] << 7 | (uint32_t)a[2] << 14; }
+
+static uint32_t pcm_begin(uint32_t area)
+{
+    if (area >= PCM_AREAS)
+        return 1;
+    pcm_up.on = 0;
+    syn_lock();
+    pcm_store_detach(area);                         /* nothing may read the area while it changes */
+    syn_unlock();
+    if (!flash_ok || st_erase(PCM_AREA[area].base))
+        return 2;
+    pcm_up.on = 1;
+    pcm_up.area = (uint8_t)area;
+    pcm_up.next = PCM_HDR_SIZE;
+    pcm_up.erased = PCM_SECTOR;
+    return 0;
+}
+
+static uint32_t pcm_write(uint32_t off, const uint8_t *a, uint32_t na)
+{
+    int n = pcm_unpack7(a, na, pcm_buf, sizeof pcm_buf);
+    uint32_t base, size;
+    if (n <= 0)
+        return 1;
+    if (!pcm_up.on || off != pcm_up.next)
+        return 3;
+    base = PCM_AREA[pcm_up.area].base;
+    size = PCM_AREA[pcm_up.area].size;
+    if ((uint32_t)n > size - off)
+        return 4;
+    while (off + (uint32_t)n > pcm_up.erased) {
+        if (st_erase(base + pcm_up.erased)) {
+            pcm_up.on = 0;
+            return 2;
+        }
+        pcm_up.erased += PCM_SECTOR;
+    }
+    if (st_prog(base + off, pcm_buf, (uint32_t)n)) {
+        pcm_up.on = 0;
+        return 2;
+    }
+    pcm_up.next = off + (uint32_t)n;
+    return 0;
+}
+
+/* -> rc; *waves: the area's waves, or the check's reason + 8 when refused */
+static uint32_t pcm_end(const uint8_t *a, uint32_t na, uint32_t *waves)
+{
+    static const uint32_t zero = 0;
+    const PcmHdr *h = (const PcmHdr *)(const void *)pcm_buf;
+    uint32_t area = pcm_up.area, base = PCM_AREA[area].base;
+    int n;
+    *waves = 0;
+    if (!pcm_up.on)
+        return 3;
+    pcm_up.on = 0;
+    if (pcm_unpack7(a, na, pcm_buf, sizeof pcm_buf) != (int)PCM_HDR_SIZE)
+        return 1;
+    if (h->len != pcm_up.next)
+        return 3;                                   /* not every byte the header covers was written */
+    if (st_prog(base, pcm_buf, PCM_HDR_SIZE))
+        return 2;
+    n = pcm_store_check(PCM_XIP(base), PCM_AREA[area].size);
+    if (n < 0) {
+        st_prog(base, &zero, 4u);                   /* the magic -> 0: the area reads empty */
+        *waves = (uint32_t)(8 - n);
+        return 5;
+    }
+    syn_lock();
+    pcm_store_attach(area, PCM_XIP(base), PCM_AREA[area].size);
+    syn_unlock();
+    *waves = (uint32_t)n;
+    return 0;
+}
+
+/* the editor's PCM commands: handled (reply built) -> 1 */
+static int ed_pcm_handle(uint32_t cmd, const uint8_t *a, uint32_t na)
+{
+    uint32_t rc, w, i, area, first, n, used;
+    switch (cmd) {
+    case ED_PCM_BEGIN:
+        area = na ? a[0] : PCM_AREAS;
+        rc = pcm_begin(area);
+        ed_b(area);
+        ed_b(rc);
+        return 1;
+    case ED_PCM_WRITE:
+        w = na >= 3u ? pcm_u21(a) : 0u;
+        rc = na > 3u ? pcm_write(w, a + 3, na - 3u) : 1u;
+        ed_b(w);
+        ed_b(w >> 7);
+        ed_b(w >> 14);
+        ed_b(rc);
+        return 1;
+    case ED_PCM_END:
+        rc = pcm_end(a, na, &w);
+        ed_b(rc);
+        ed_b(w);
+        return 1;
+    case ED_PCM_INFO:
+        area = na ? a[0] : 0u;
+        first = na > 1u ? a[1] : 0u;
+        ed_b(PCM_AREAS);
+        ed_b(area);
+        if (area >= PCM_AREAS) {
+            ed_b(0);
+            return 1;
+        }
+        n = pcm_area_count(area);
+        used = pcm_area_used(area);
+        ed_b(n);
+        ed_b(PCM_AREA[area].size / 1024u);
+        ed_b((PCM_AREA[area].size / 1024u) >> 7);
+        ed_b(used);
+        ed_b(used >> 7);
+        ed_b(used >> 14);
+        for (w = 0, i = 0; i < area; i++)
+            w += pcm_area_count(i);                 /* the area's first wave in the whole list */
+        for (i = first; i < n && i < first + 16u; i++) {
+            const PcmEntry *e = pcm_wave(w + i, NULL);
+            char s[PCM_NAME_LEN + 1];
+            uint32_t k;
+            for (k = 0; k < PCM_NAME_LEN; k++)
+                s[k] = e->name[k];
+            s[PCM_NAME_LEN] = 0;
+            ed_str(s, PCM_NAME_LEN);
+        }
+        return 1;
+    default:
+        return 0;
+    }
+}
diff --git a/src/hardware/pcm_store_upload.py b/src/hardware/pcm_store_upload.py
new file mode 100644
index 0000000..118f575
--- /dev/null
+++ b/src/hardware/pcm_store_upload.py
@@ -0,0 +1,316 @@
+#!/usr/bin/env python3
+"""PCM waves for the FM1 (2026-10-21): build an image from WAV files and upload it to one of the free flash areas the
+firmware reads PCM waves from (src/dsp/pcm_store.h, src/hardware/pcm_store_fm1.c), over USB-MIDI.
+
+  pcm_store_upload.py build OUT.bin [options] WAV...   make an image (no device needed)
+      --ulaw          store 8-bit mu-law (the attacks' codec: half the flash, a little hiss) instead of 16-bit
+      --cycle N       every WAV is N whole cycles of one wave (single-cycle: N = 1); it loops end to end and plays
+                      at any pitch. Otherwise the WAV's 'smpl' chunk gives its loop and root note (no chunk: one-shot,
+                      root --root, default 60)
+      --demo          two made-up waves instead of WAVs (a 16-bit saw cycle, a looped mu-law tone): for the tests
+  pcm_store_upload.py info                             what each area holds
+  pcm_store_upload.py upload IMAGE --area A            write IMAGE to area A (0: 36 KiB, 1: 56 KiB)
+  pcm_store_upload.py clear --area A                   empty area A
+  pcm_store_upload.py syx IMAGE OUT.syx --area A       no device: the upload's SysEx frames, for
+                                                       src/host/test_pcm_store.c
+
+Names come from the file names (12 characters, upper case). WAVs: PCM 8/16/24/32-bit or float32, any rate from 4 kHz
+to 96 kHz, stereo is mixed to mono. Nothing in the firmware plays the waves yet: this only fills the flash. Needs mido
+and a backend such as python-rtmidi for the device commands.
+"""
+import argparse
+import math
+import struct
+import sys
+import time
+import zlib
+from pathlib import Path
+
+HDR = [0x7D, 0x46, 0x4C]
+PCM_BEGIN, PCM_WRITE, PCM_END, PCM_INFO = 100, 101, 102, 103
+MAGIC, VERSION = 0x57505243, 1
+HDR_SIZE, ENTRY_SIZE, NAME_LEN, MAX_WAVES = 32, 36, 12, 64
+FMT_S16, FMT_ULAW = 0, 1
+FLAG_LOOP, FLAG_CYCLE = 1, 2
+AREA_SIZE = {0: 0x9000, 1: 0xE000}
+CHUNK = 256
+RC = {1: "arguments", 2: "flash", 3: "order", 4: "too big for the area", 5: "refused by the image check"}
+CHECK = {-1: "no image", -2: "header", -3: "an entry", -4: "data CRC"}
+
+
+# ---------------------------------------------------------------------------------------------------- WAV files ---
+def read_wav(path):
+    """-> (samples as floats -1..1, mono; rate; smpl chunk as (root, loop_start, loop_end) or None)"""
+    b = Path(path).read_bytes()
+    if b[:4] != b"RIFF" or b[8:12] != b"WAVE":
+        sys.exit(f"{path}: not a WAV file")
+    fmt = data = smpl = None
+    i = 12
+    while i + 8 <= len(b):
+        cid, n = b[i:i + 4], struct.unpack_from("<I", b, i + 4)[0]
+        body = b[i + 8:i + 8 + n]
+        if cid == b"fmt ":
+            fmt = struct.unpack_from("<HHIIHH", body)
+            if fmt[0] == 0xFFFE and len(body) >= 26:            # WAVE_FORMAT_EXTENSIBLE: the sub-format's tag
+                fmt = (struct.unpack_from("<H", body, 24)[0],) + fmt[1:]
+        elif cid == b"data":
+            data = body
+        elif cid == b"smpl" and len(body) >= 36:
+            root = struct.unpack_from("<I", body, 12)[0]
+            loops = struct.unpack_from("<I", body, 28)[0]
+            lp = struct.unpack_from("<II", body, 36 + 8) if loops and len(body) >= 60 else None
+            smpl = (root, lp[0], lp[1] + 1) if lp else (root, None, None)   # smpl's loop end is inclusive
+        i += 8 + n + (n & 1)
+    if not fmt or data is None:
+        sys.exit(f"{path}: no fmt / data chunk")
+    tag, ch, rate, _, _, bits = fmt
+    w = bits // 8
+    if (tag, bits) not in ((1, 8), (1, 16), (1, 24), (1, 32), (3, 32)):
+        sys.exit(f"{path}: {bits}-bit format {tag} is not supported (PCM 8/16/24/32-bit or float32)")
+    frames = len(data) // (w * ch)
+    out = []
+    for f in range(frames):
+        acc = 0.0
+        for c in range(ch):
+            o = (f * ch + c) * w
+            if tag == 3:
+                v = struct.unpack_from("<f", data, o)[0]
+            elif bits == 8:
+                v = (data[o] - 128) / 128.0
+            else:
+                v = int.from_bytes(data[o:o + w], "little", signed=True) / float(1 << (bits - 1))
+            acc += v
+        out.append(max(-1.0, min(1.0, acc / ch)))
+    return out, rate, smpl
+
+
+def ulaw(x):
+    """the attacks' 8-bit mu-law (src/dsp/gen_attacks.py mulaw_encode): int8 -127..127 as a byte"""
+    y = math.copysign(math.log1p(255.0 * abs(x)) / math.log1p(255.0), x)
+    return max(-127, min(127, round(y * 127.0))) & 0xFF
+
+
+def s16(x):
+    return max(-32768, min(32767, round(x * 32768.0)))
+
+
+# -------------------------------------------------------------------------------------------------------- image ---
+def make_image(waves):
+    """waves: dicts name, fmt, flags, root, cycles, rate, samples (floats), loop (start, end) or None -> bytes"""
+    if len(waves) > MAX_WAVES:
+        sys.exit(f"{len(waves)} waves: an area holds at most {MAX_WAVES}")
+    off = HDR_SIZE + ENTRY_SIZE * len(waves)
+    entries, blobs = [], []
+    for w in waves:
+        off = (off + 3) & ~3
+        blob = bytes(ulaw(x) for x in w["samples"]) if w["fmt"] == FMT_ULAW else \
+            b"".join(struct.pack("<h", s16(x)) for x in w["samples"])
+        ls, le = w["loop"] if w["loop"] else (0, 0)
+        name = w["name"].upper().encode("ascii", "replace")[:NAME_LEN].ljust(NAME_LEN, b"\0")
+        entries.append(struct.pack("<12sBBBBIIIII", name, w["fmt"], w["flags"], w["root"], w["cycles"],
+                                   w["rate"], off, len(w["samples"]), ls, le))
+        blobs.append((off, blob))
+        off += len(blob)
+    body = bytearray(off - HDR_SIZE)
+    body[:ENTRY_SIZE * len(waves)] = b"".join(entries)
+    for o, blob in blobs:
+        body[o - HDR_SIZE:o - HDR_SIZE + len(blob)] = blob
+    h = struct.pack("<IHHII12x", MAGIC, VERSION, len(waves), off, zlib.crc32(body))
+    return h + struct.pack("<I", zlib.crc32(h)) + bytes(body)
+
+
+def parse_image(img):
+    """-> (count, len, [(name, fmt, flags, root, cycles, rate, off, len, ls, le)]); SystemExit when not an image"""
+    if len(img) < HDR_SIZE:
+        sys.exit("too short for a PCM image")
+    magic, ver, count, n, crc = struct.unpack_from("<IHHII", img)
+    if magic != MAGIC or ver != VERSION or zlib.crc32(img[:28]) != struct.unpack_from("<I", img, 28)[0]:
+        sys.exit("not a PCM wave image (pcm_store_upload.py build)")
+    if n != len(img) or zlib.crc32(img[HDR_SIZE:]) != crc:
+        sys.exit("damaged PCM image (length or data CRC)")
+    ents = [struct.unpack_from("<12sBBBBIIIII", img, HDR_SIZE + i * ENTRY_SIZE) for i in range(count)]
+    return count, n, [(e[0].rstrip(b"\0").decode("ascii", "replace"),) + e[1:] for e in ents]
+
+
+def demo_waves():
+    saw = [2.0 * i / 600 - 1.0 for i in range(600)]                 # one cycle, 600 samples
+    tone = [0.5 * math.sin(2 * math.pi * 440.0 * i / 22050) * min(1.0, i / 200) for i in range(2205)]
+    return [dict(name="DEMO SAW", fmt=FMT_S16, flags=FLAG_LOOP | FLAG_CYCLE, root=60, cycles=1, rate=0,
+                 samples=saw, loop=(0, 600)),
+            dict(name="DEMO TONE", fmt=FMT_ULAW, flags=FLAG_LOOP, root=69, cycles=0, rate=22050,
+                 samples=tone, loop=(1103, 2205))]
+
+
+def build(a):
+    if a.demo:
+        waves = demo_waves()
+    else:
+        if not a.wavs:
+            sys.exit("build: name some WAV files (or --demo)")
+        waves = []
+        for p in a.wavs:
+            x, rate, smpl = read_wav(p)
+            if not x:
+                sys.exit(f"{p}: no samples")
+            fmt = FMT_ULAW if a.ulaw else FMT_S16
+            name = Path(p).stem.replace("_", " ")
+            if a.cycle:
+                waves.append(dict(name=name, fmt=fmt, flags=FLAG_LOOP | FLAG_CYCLE, root=60, cycles=a.cycle,
+                                  rate=0, samples=x, loop=(0, len(x))))
+                continue
+            if not 4000 <= rate <= 96000:
+                sys.exit(f"{p}: {rate} Hz, outside 4..96 kHz")
+            root, ls, le = smpl if smpl else (a.root, None, None)
+            loop = (ls, min(le, len(x))) if ls is not None and ls < min(le, len(x)) else None
+            waves.append(dict(name=name, fmt=fmt, flags=FLAG_LOOP if loop else 0, root=min(127, root), cycles=0,
+                              rate=rate, samples=x, loop=loop))
+    img = make_image(waves)
+    Path(a.out).write_bytes(img)
+    fits = [str(k) for k, s in AREA_SIZE.items() if len(img) <= s]
+    print(f"wrote {a.out}: {len(waves)} waves, {len(img)} bytes; "
+          + (f"fits area {' and '.join(fits)}" if fits else f"TOO BIG for any area (largest {max(AREA_SIZE.values())})"))
+    for w in parse_image(img)[2]:
+        kind = f"{w[4]} cycle loop" if w[2] & FLAG_CYCLE else (f"{w[5]} Hz, root {w[3]}" +
+                                                             (", looped" if w[2] & FLAG_LOOP else ", one-shot"))
+        print(f"  {w[0]:<12} {'mu-law' if w[1] else '16-bit'} {w[7]:6d} samples  {kind}")
+
+
+# ------------------------------------------------------------------------------------------------------ the link ---
+def pack7(b):
+    """groups of up to 7 bytes, each preceded by their top bits (pcm_store_fm1.c pcm_unpack7)"""
+    out = []
+    for i in range(0, len(b), 7):
+        g = b[i:i + 7]
+        out.append(sum(((x >> 7) & 1) << j for j, x in enumerate(g)))
+        out += [x & 0x7F for x in g]
+    return out
+
+
+def u21(v):
+    return [v & 0x7F, (v >> 7) & 0x7F, (v >> 14) & 0x7F]
+
+
+def frames(img, area):
+    """the upload as (cmd, args): BEGIN, the bytes after the header in order, then the header (END)"""
+    yield PCM_BEGIN, [area]
+    for off in range(HDR_SIZE, len(img), CHUNK):
+        yield PCM_WRITE, u21(off) + pack7(img[off:off + CHUNK])
+    yield PCM_END, pack7(img[:HDR_SIZE])
+
+
+class Link:
+    def __init__(self):
+        try:
+            import mido
+        except ImportError:
+            sys.exit("needs mido: pip install mido python-rtmidi")
+        self.mido = mido
+        fm1 = lambda n: any(k in n for k in ("FM-1", "X0X", "Felucca"))    # X0X's platform names it "X0X FM-1"
+        outs = [n for n in mido.get_output_names() if fm1(n)]
+        ins = [n for n in mido.get_input_names() if fm1(n)]
+        if not outs or not ins:
+            sys.exit("no FM1 MIDI port (X0X FM-1): connect the FM1 by USB")
+        self.o = mido.open_output(outs[0])
+        self.i = mido.open_input(ins[0])
+
+    def req(self, cmd, args, timeout=3.0):
+        for _ in self.i.iter_pending():
+            pass
+        self.o.send(self.mido.Message("sysex", data=HDR + [cmd] + list(args)))
+        end = time.monotonic() + timeout
+        while time.monotonic() < end:
+            for m in self.i.iter_pending():
+                d = list(m.data) if m.type == "sysex" else []
+                if d[:4] == HDR + [cmd]:
+                    return d[4:]
+            time.sleep(0.002)
+        raise TimeoutError(f"no reply to command {cmd}: is Carnac OS 0.9.2 or later on the FM1?")
+
+
+def area_info(link, area):
+    """-> (waves, size bytes, used bytes, names)"""
+    r = link.req(PCM_INFO, [area, 0])
+    if len(r) < 3 or r[1] != area or len(r) < 8:
+        sys.exit(f"area {area}: no such area on the device")
+    n, size, used = r[2], (r[3] | r[4] << 7) * 1024, r[5] | r[6] << 7 | r[7] << 14
+    names, i, first = [], 8, 0
+    while True:
+        while len(names) < n and i < len(r):
+            j = r.index(0, i)
+            names.append(bytes(r[i:j]).decode("ascii", "replace"))
+            i = j + 1
+        if len(names) >= n:
+            return n, size, used, names
+        first = len(names)
+        r, i = link.req(PCM_INFO, [area, first]), 8
+
+
+def info(link):
+    areas = link.req(PCM_INFO, [0, 0])[0]
+    for a in range(areas):
+        n, size, used, names = area_info(link, a)
+        print(f"area {a}: {size // 1024} KiB, {'empty' if not used else f'{used} bytes used, {n} waves'}")
+        for k, nm in enumerate(names):
+            print(f"  {k:2d} {nm}")
+
+
+def run(link, reqs):
+    for k, (cmd, args) in enumerate(reqs):
+        r = link.req(cmd, args, timeout=5.0)
+        rc = r[3] if cmd == PCM_WRITE else r[1] if cmd == PCM_BEGIN else r[0]
+        if rc:
+            why = RC.get(rc, "?")
+            if cmd == PCM_END and rc == 5:
+                why += f" ({CHECK.get(8 - r[1], '?')})"
+            sys.exit(f"\ncommand {cmd} failed: rc {rc} ({why})")
+        print(f"\r{k + 1}/{len(reqs)}", end="", flush=True)
+    print()
+
+
+def main(argv):
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sp = ap.add_subparsers(dest="cmd", required=True)
+    b = sp.add_parser("build")
+    b.add_argument("out")
+    b.add_argument("wavs", nargs="*")
+    b.add_argument("--ulaw", action="store_true")
+    b.add_argument("--cycle", type=int, default=0)
+    b.add_argument("--root", type=int, default=60)
+    b.add_argument("--demo", action="store_true")
+    sp.add_parser("info")
+    for name in ("upload", "syx"):
+        p = sp.add_parser(name)
+        p.add_argument("image")
+        if name == "syx":
+            p.add_argument("out")
+        p.add_argument("--area", type=int, required=True, choices=sorted(AREA_SIZE))
+    c = sp.add_parser("clear")
+    c.add_argument("--area", type=int, required=True, choices=sorted(AREA_SIZE))
+    a = ap.parse_args(argv)
+    if a.cmd == "build":
+        if a.cycle < 0 or a.cycle > 255:
+            sys.exit("--cycle: 1..255")
+        return build(a)
+    if a.cmd in ("upload", "syx"):
+        img = Path(a.image).read_bytes()
+        parse_image(img)
+        if len(img) > AREA_SIZE[a.area]:
+            sys.exit(f"{a.image}: {len(img)} bytes, area {a.area} holds {AREA_SIZE[a.area]}")
+        reqs = list(frames(img, a.area))
+        if a.cmd == "syx":
+            out = b"".join(bytes([0xF0] + HDR + [cmd] + args + [0xF7]) for cmd, args in reqs)
+            Path(a.out).write_bytes(out)
+            print(f"wrote {a.out}: {len(reqs)} frames, {len(out)} bytes")
+            return
+        link = Link()
+        run(link, reqs)
+        info(link)
+        return
+    link = Link()
+    if a.cmd == "clear":
+        run(link, [(PCM_BEGIN, [a.area])])
+    info(link)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:])
